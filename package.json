{
  "name": "orw-node",
  "private": true,
  "version": "0.5.0-dev",
  "type": "module",
  "scripts": {
    "build:server:prod": "tsc -p server/tsconfig.json",
    "build:client:prod": "tsc && vite build --mode production",
    "build:prod": "pnpm run build:client:prod && pnpm run build:server:prod",
    "start:server:prod": "node --env-file .env.production.local server/dist/server/watcher.js",
    "start:prod": "./tools/start-prod.sh",
    "build:server:dev": "tsc -p server/tsconfig.json",
    "build:client:dev": "tsc && vite build --mode development",
    "build:dev": "pnpm run build:client:dev && pnpm run build:server:dev",
    "start:server:dev": "node --env-file .env.development server/dist/server/watcher.js",
    "start:dev": "./tools/start-dev.sh",
    "start": "pnpm run start:prod",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --open",
    "watch:standalone": "vite --mode development --open",
    "watch": "pnpm run start:server & vite --mode development --open",
    "doc": "typedoc --plugin typedoc-plugin-mdn-links && open ./docs/index.html",
    "backup": "./backup/backup.sh && ./backup/reset.sh",
    "reset": "./backup/reset.sh",
    "clean": "rm -fR node_modules package-lock.json data/cache && pnpm install --include dev",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage && open ./coverage/index.html"
  },
  "dependencies": {
    "@kitsuyui/luxon-ext": "^0.2.1",
    "better-sqlite3": "^12.2.0",
    "deep-diff": "^1.0.2",
    "globals": "^16.3.0",
    "luxon": "^3.7.1",
    "mime-types": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/deep-diff": "^1.0.5",
    "@types/luxon": "^3.6.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/rss": "^0.0.32",
    "@typescript-eslint/eslint-plugin": "rc-v8",
    "@typescript-eslint/parser": "rc-v8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react-data-table-component": "^7.7.0",
    "react-router-dom": "^7.7.0",
    "styled-components": "^6.1.19",
    "typedoc": "^0.28.7",
    "typedoc-plugin-mdn-links": "^5.0.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vite-plugin-compression2": "^2.2.0",
    "vitest": "^3.2.4"
  }
}