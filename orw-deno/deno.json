{
  "name": "orw-deno",
  "exports": {
    ".": "./server/main.ts"
  },
  "version": "0.6.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-all --watch=components/,islands/,lib/,routes/,server/,static/,main.ts dev.ts",
    "serve": "deno task build && deno serve --allow-all --env-file=.env _fresh/server.js",
    "serve-prod": "deno serve --allow-all _fresh/server.js",
    "build": "deno run --allow-all dev.ts build",
    "test": "deno test --allow-all --reporter=dot tests/",
    "test-cov": "deno test --allow-all --reporter=dot --coverage --coverage-raw-data-only tests/",
    "coverage": "deno coverage --include=\"routes/\" --include=\"server/\"",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check components islands lib routes server static tests main.ts dev.ts",
    "pre-commit": "deno task fmt && deno task lint && deno task check && deno task test",
    "update": "deno run -A -r jsr:@fresh/update .",
    "compile": "false && deno task build && deno compile --output orw.bin --include static --include _fresh --include deno.json -A main.ts"
  },
  "exclude": [
    "**/_fresh/*",
    "**/data/*"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@fresh/core": "jsr:@fresh/core@2.0.0-alpha.46",
    "fresh/do-not-use": "jsr:@fresh/core@2.0.0-alpha.46/do-not-use",
    "@fresh/plugin-tailwind": "jsr:@fresh/plugin-tailwind@0.0.1-alpha.9",
    "preact": "npm:preact@10.26.9",
    "preact/hooks": "npm:preact@10.26.9/hooks",
    "@preact/signals": "npm:@preact/signals@2.2.1",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "daisyui": "npm:daisyui@^5.0.48",
    "luxon": "npm:luxon@3.7.1",
    "@kitsuyui/luxon-ext": "npm:@kitsuyui/luxon-ext@0.2.1",
    "sqlite": "node:sqlite",
    "rss": "npm:rss@1.2.2",
    "deep-diff": "npm:deep-diff@1.0.2"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  }
}
