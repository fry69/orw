{
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head"
    ],
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "types": [
      "npm:@types/luxon@3.7.1",
      "npm:@types/rss@0.0.32"
    ]
  },
  "exclude": [
    "**/_fresh/*",
    "**/data/*"
  ],
  "exports": {
    ".": "./main.ts"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false
  },
  "imports": {
    "@fresh/plugin-tailwind": "jsr:@fresh/plugin-tailwind@0.0.1-alpha.9",
    "@kitsuyui/luxon-ext": "npm:@kitsuyui/luxon-ext@0.2.1",
    "@preact/signals": "npm:@preact/signals@2.3.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/path": "jsr:@std/path@1",
    "daisyui": "npm:daisyui@5.0.51",
    "deep-diff": "npm:deep-diff@1.0.2",
    "fresh": "jsr:@fresh/core@2.0.0-alpha.63",
    "luxon": "npm:luxon@3.7.1",
    "preact": "npm:preact@10.27.1",
    "feed": "npm:feed@5.1.0",
    "rss": "npm:rss@1.2.2",
    "tailwindcss": "npm:tailwindcss@4.1.12"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "name": "orw-deno",
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run --allow-all dev.ts build",
    "check": "deno check components islands lib routes server static tests main.ts dev.ts utils.ts",
    "check-deps": "deno run -A jsr:@check/deps --allow-unused",
    "dev": "deno run --allow-all --watch=components/,islands/,lib/,routes/,server/,static/,main.ts,utils.ts dev.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "install": "deno install --allow-scripts",
    "pre-commit": "deno task install && deno task fmt && deno task lint && deno task check && deno task test",
    "serve": "deno task build && deno serve --allow-all --env-file=.env _fresh/server.js",
    "serve-prod": "deno serve --allow-all _fresh/server.js",
    "test": "deno test --allow-all --reporter=dot tests/"
  },
  "version": "0.6.0"
}
