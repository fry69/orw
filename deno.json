{
  "name": "orw-deno",
  "exports": {
    ".": "./server/main.ts"
  },
  "version": "0.6.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-all --watch=components/,islands/,lib/,routes/,server/,static/,types/,main.ts dev.ts",
    "serve": "deno serve --allow-all --env-file=.env _fresh/server.js",
    "serve-prod": "deno serve --allow-all _fresh/server.js",
    "build": "deno run --allow-all dev.ts build",
    "test": "deno test --allow-all --reporter=dot test/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check components islands lib routes server static test types main.ts dev.ts",
    "pre-commit": "deno task fmt && deno task lint && deno task check && deno task test",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "exclude": [
    "**/_fresh/*",
    "**/data/*",
    "**/docs/*"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/crypto": "jsr:@std/crypto@1",
    "@std/http": "jsr:@std/http@1",
    "@std/http/file-server": "jsr:@std/http@1/file-server",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/streams": "jsr:@std/streams@1",
    "@std/cli": "jsr:@std/cli@1",
    "fresh": "jsr:@fresh/core@2.0.0-alpha.46",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@fresh/plugin-tailwind": "jsr:@fresh/plugin-tailwind@0.0.1-alpha.9",
    "preact": "npm:preact@10.26.9",
    "preact/hooks": "npm:preact@10.26.9/hooks",
    "preact/jsx-runtime": "npm:preact@10.26.9/jsx-runtime",
    "@preact/signals": "npm:@preact/signals@2.2.1",
    "deep-diff": "npm:deep-diff@1.0.2",
    "luxon": "npm:luxon@3.7.1",
    "@kitsuyui/luxon-ext": "npm:@kitsuyui/luxon-ext@0.2.1",
    "rss": "npm:rss@1.2.2",
    "sqlite": "node:sqlite",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.10",
    "postcss": "npm:postcss@^8.5.6"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  }
}
