{
  "name": "orw-deno",
  "version": "0.5.0",
  "tasks": {
    "dev": "deno run --allow-all server/main.ts --port 3100",
    "start": "deno run --allow-all server/main.ts --background --port 3100",
    "check": "deno run --allow-all server/main.ts --run-once",
    "query": "deno run --allow-all server/main.ts --query 10",
    "build": "deno compile --allow-all --output orw server/main.ts",
    "test": "deno test --allow-all",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/crypto": "jsr:@std/crypto@1",
    "@std/http": "jsr:@std/http@1",
    "@std/http/file-server": "jsr:@std/http@1/file-server",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/streams": "jsr:@std/streams@1",
    "@std/cli": "jsr:@std/cli@1",
    "react": "npm:react@19.1.0",
    "react-dom": "npm:react-dom@19.1.0",
    "react-router-dom": "npm:react-router-dom@7.7.0",
    "styled-components": "npm:styled-components@6.1.19",
    "react-data-table-component": "npm:react-data-table-component@7.7.0",
    "deep-diff": "npm:deep-diff@1.0.2",
    "luxon": "npm:luxon@3.7.1",
    "rss": "npm:rss@1.2.2",
    "sqlite": "jsr:@db/sqlite@0.12"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
