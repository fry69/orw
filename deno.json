{
  "name": "orw-deno",
  "exports": {
    ".": "./server/main.ts"
  },
  "version": "0.6.0",
  "tasks": {
    "dev": "deno run --allow-all server/main.ts --port 3100",
    "start": "deno run --allow-all server/main.ts --background --port 3100",
    "once": "deno run --allow-all server/main.ts --run-once",
    "query": "deno run --allow-all server/main.ts --query 10",
    "build": "deno compile --allow-all --output orw server/main.ts",
    "build:frontend": "deno run --allow-all scripts/build.ts",
    "build:frontend:dev": "deno run --allow-all scripts/build.ts --dev",
    "build:frontend:watch": "deno run --allow-all scripts/build.ts --dev --watch",
    "build:all": "deno task build:frontend && deno task build",
    "test": "deno test --allow-all",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check",
    "pre-commit": "deno task fmt && deno task lint && deno task check && deno task build:frontend && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/crypto": "jsr:@std/crypto@1",
    "@std/http": "jsr:@std/http@1",
    "@std/http/file-server": "jsr:@std/http@1/file-server",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/streams": "jsr:@std/streams@1",
    "@std/cli": "jsr:@std/cli@1",
    "react": "npm:react@19",
    "react/jsx-runtime": "npm:react@19/jsx-runtime",
    "react-dom": "npm:react-dom@19",
    "react-dom/client": "npm:react-dom@19/client",
    "react-router-dom": "npm:react-router-dom@7.7.0",
    "deep-diff": "npm:deep-diff@1.0.2",
    "luxon": "npm:luxon@3.7.1",
    "@kitsuyui/luxon-ext": "npm:@kitsuyui/luxon-ext@0.2.1",
    "rss": "npm:rss@1.2.2",
    "sqlite": "jsr:@db/sqlite@0.12"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react",
    "lib": ["dom", "deno.ns"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
