  //   app.get("/changes", (ctx) => ctx.render(changesModule.default({})));
  //   app.get("/list", (ctx) => ctx.render(listModule.default({})));
  //   app.get("/removed", (ctx) => ctx.render(removedModule.default({})));
  //   app.get("/api/status", statusModule.handler);
  //   app.get("/api/lists", listsModule.handler);

  //   console.log("Manual routes registered successfully.");
